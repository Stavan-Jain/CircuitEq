+theorem gather_step (h d t ht dt : Circuit 48) (he : t ≡ᵤ ht ++ dt)
+    (hc : d ++ ht ≡ᵤ ht ++ d) : h ++ d ++ t ≡ᵤ (h ++ ht) ++ (d ++ dt) := by
+  have p := (Equivalent.refl (h ++ d)).append he
+  have q := hc.in_context h dt
+  exact p.trans (by simpa only [List.append_assoc] using q)
+'''
