+import re,pathlib,collections
+p=pathlib.Path('Solution')
+s=pathlib.Path('Harness/Task.lean').read_text()
+def parse(name):return re.findall(r'(?:CX \d+ \d+|(?:H|Tdg|T|Sdg|S|Z|X|Y) \d+)',s.split('def '+name)[1].split(':=',1)[1].split(']')[0])
+a,b=parse('original'),parse('optimized')
+def lit(xs):return '['+', '.join(xs)+']'
+def decl(name,x):return f'def {name} : Circuit 48 :=\n  {lit(x)}\n'
+A=[a[15:2055],a[2131:4443]]
+assert all(len(x)%17==0 for x in A)
+D=[[g for g in x if not g.startswith('H ')] for x in A]
+B=[b[:1233],b[1293:2687]]
+E=[[g for g in x if not g.startswith('H ')] for x in B]
+H=[a[:15],a[2115:2131]]
+mid=a[2055:2131]
+r=[]
+for i in range(32):
+ count=sum(x==f'T {i}' for x in D[0])%8
+ for gate in (['Z'] if count>=4 else [])+(['S'] if count%4>=2 else [])+(['T'] if count%2 else []):r.append(f'{gate} {i}')
+out='import CircuitEq\nimport Harness.Task\nset_option Elab.async false\nset_option maxRecDepth 50000\nset_option maxHeartbeats 0\nnamespace Quantum.Circuit.Harness\nopen Instr\n'
+for j in range(2):
+ for name,x in [(f'a{j}',A[j]),(f'd{j}',D[j]),(f'b{j}',B[j]),(f'e{j}',E[j]),(f'h{j}',H[j])]:out+=decl(name,x)
+out+=decl('middle',mid)+decl('residual',r)
+for j in range(2):
+ for k in range(len(A[j])//17):
+  x=A[j][k*17:(k+1)*17];y=[g for g in x if not g.startswith('H ')]
+  out+=decl(f'ac{j}_{k}',x)+decl(f'dc{j}_{k}',y)
+ for k,x in enumerate(re.split(r'(?=H \d+)',', '.join(B[j]))):
+  pass
+ groups=[]
+ for x in B[j]:
+  if x.startswith('H '):groups.append([x])
+  else:groups[-1].append(x)
+ for k,x in enumerate(groups):out+=decl(f'eg{j}_{k}',x[1:])
+ out+=f'\n-- groups {len(groups)}\n'
+out+='end Quantum.Circuit.Harness\n'
+(p/'Data.lean').write_text(out)
+print('A',list(map(len,A)),'D',list(map(len,D)),'E',list(map(len,E)),'residual',r)
+# A generic 3-wire cancellation template.
+x=A[0][:17];w=sorted({int(y) for g in x for y in g.split()[1:]})
+small=[re.sub(r'\d+',lambda m:str(w.index(int(m[0]))),g) for g in x]
+clean=[g for g in small if not g.startswith('H ')]
+base='import Solution.Data\nset_option Elab.async false\nset_option maxRecDepth 50000\nset_option maxHeartbeats 0\nnamespace Quantum.Circuit.Harness\nopen Instr\n'
+norm=base+f'theorem local_cancel : ({lit(small)} : Circuit 3) ≡ᵤ {lit(clean)} := by\n  circuit_simp\n'
+for j in range(2):
+ terms=[]
+ for k in range(len(A[j])//17):
+  x=A[j][17*k:17*(k+1)];w=sorted({int(y) for g in x for y in g.split()[1:]})
+  assert [re.sub(r'\d+',lambda m:str(w.index(int(m[0]))),g) for g in x]==small
+  norm+=f'theorem cancel{j}_{k} : ac{j}_{k} ≡ᵤ dc{j}_{k} :=\n  Equivalent.of_rename (wires₃ (a := {w[0]}) (b := {w[1]}) (c := {w[2]}) (by decide) (by decide) (by decide)) local_cancel rfl rfl\n'
+  terms.append(f'cancel{j}_{k}')
+ def combine(ts):
+  if len(ts)==1:return ts[0]
+  k=len(ts)//2;return f'({combine(ts[:k])}).append ({combine(ts[k:])})'
+ norm+=f'theorem normalize{j} : a{j} ≡ᵤ d{j} := by\n  exact {combine(terms)}\n'
+norm+='end Quantum.Circuit.Harness\n';(p/'Normalize.lean').write_text(norm)
